# ---------------------------------------------------------------------------
# Throttle — https://usethrottle.dev
# ---------------------------------------------------------------------------
# Server-side API key from https://app.usethrottle.dev (Settings → API keys).
# Must start with "sk_". Never commit this or expose it to the browser.
#
# CRITICAL — mode matters: sk_test_… is Throttle TEST mode, so no real payment
# is ever taken. Real orders need ALL THREE: an sk_live_… key, a live-mode
# store, and a connected payment processor. A mismatch (live key + test store,
# or vice versa) makes every subsystem look independently broken — carts,
# checkout sessions and webhooks all fail in confusing ways. Check the mode
# first when things look inexplicably broken.
THROTTLE_API_KEY=replace_with_your_throttle_secret_key

# Throttle store/application UUID that the starter writes carts and orders to.
# Find it in the dashboard under Stores, or via `curl -H "x-api-key: $THROTTLE_API_KEY" https://api.usethrottle.dev/api/v1/stores`.
THROTTLE_STORE_ID=00000000-0000-0000-0000-000000000000

# Shared secret used to verify webhook signatures. Returned exactly once
# when you create a webhook endpoint via the API or dashboard.
THROTTLE_WEBHOOK_SECRET=replace_with_your_throttle_webhook_secret

# Override only if you are pointed at a Throttle staging or self-hosted
# environment. Defaults are correct for production usethrottle.dev.
# THROTTLE_API_BASE_URL=https://api.usethrottle.dev
# NEXT_PUBLIC_THROTTLE_CHECKOUT_URL=https://checkout.usethrottle.dev

# Parent origin sent to the PaymentEmbed iframe. Must be in your
# store's allowed_origins list (Embed config in the Throttle dashboard,
# or PUT /api/v1/embed-config). Falls back to NEXT_PUBLIC_BASE_URL or
# window.location.origin at runtime if omitted.
# NEXT_PUBLIC_THROTTLE_PARENT_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Clerk — https://clerk.com (default auth provider)
# ---------------------------------------------------------------------------
# Without these, the starter falls back to a localStorage-backed mock auth
# so the UI still renders. Wire Clerk before deploying to production.
# Both keys live in your Clerk dashboard (API Keys page).
CLERK_SECRET_KEY=replace_with_your_clerk_secret_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_your_clerk_publishable_key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin of the deployed storefront. Used for canonical URLs, the
# sitemap, and OG tags — set it to the production domain before launch, or
# every canonical/OG URL points at localhost. Defaults to http://localhost:3000.
# NEXT_PUBLIC_BASE_URL=https://www.brand.com

# ---------------------------------------------------------------------------
# Adapter fetch tuning (optional)
# ---------------------------------------------------------------------------
# src/lib/http/fetch-with-retry.ts reads <PREFIX>_FETCH_MAX_ATTEMPTS and
# <PREFIX>_FETCH_TIMEOUT_MS, where <PREFIX> is whatever an adapter passes to
# fetchRetryOptionsFromEnv(). Defaults: 3 attempts, 10s per attempt. Raise the
# timeout for a slow PIM; raise attempts only for read-only (GET) traffic.
# EXAMPLE_FETCH_MAX_ATTEMPTS=3
# EXAMPLE_FETCH_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Optional connector modules — NOT IMPLEMENTED IN THIS STARTER YET
# ---------------------------------------------------------------------------
# Listed here so a project that ports one from a client build knows the exact
# variable names to reuse. Setting them today does nothing — see
# docs/STARTER-IMPROVEMENTS.md §C for the module contract and current status.
# Enable only what the client actually uses; absence must mean fully off.
#
# Guest order receipts (§B1): signs the order-confirmation token so a guest can
# view their receipt without an account. Falls back to THROTTLE_API_KEY.
# ORDER_CONFIRMATION_SECRET=<long random string>
#
# MiniPim PIM adapter (§C1)
# MINIPIM_API_KEY / MINIPIM_ORGANIZATION_ID / MINIPIM_CHANNEL
# tuning: MINIPIM_FETCH_MAX_ATTEMPTS / MINIPIM_FETCH_TIMEOUT_MS /
#         MINIPIM_DATA_CACHE_REVALIDATE / CATEGORY_SCOPE
#
# Evident reviews/UGC (§C2)
# EVIDENT_API_KEY / NEXT_PUBLIC_EVIDENT_STORE_ID / NEXT_PUBLIC_EVIDENT_WIDGET_SRC
#
# Zendesk chat (§C3)
# NEXT_PUBLIC_ZENDESK_KEY
#
# Throttle Quote/RFQ (§C4) — the qrf_ value in the form's dashboard URL
# THROTTLE_QUOTE_FORM_TOKEN=qrf_...
#
# Resend mailer + contact/returns forms (§C5)
# RESEND_API_KEY / EMAIL_FROM (verified domain) / CONTACT_FORM_TO / RETURNS_TO
