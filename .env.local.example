# ---------------------------------------------------------------------------
# Throttle — https://usethrottle.dev
# ---------------------------------------------------------------------------
# Server-side API key from https://app.usethrottle.dev (Settings → API keys).
# Must start with "sk_". Never commit this or expose it to the browser.
THROTTLE_API_KEY=replace_with_your_throttle_secret_key

# Throttle store/application UUID that the starter writes carts and orders to.
# Find it in the dashboard under Stores, or via `curl -H "x-api-key: $THROTTLE_API_KEY" https://api.usethrottle.dev/api/v1/stores`.
THROTTLE_STORE_ID=00000000-0000-0000-0000-000000000000

# Shared secret used to verify webhook signatures. Returned exactly once
# when you create a webhook endpoint via the API or dashboard.
THROTTLE_WEBHOOK_SECRET=replace_with_your_throttle_webhook_secret

# Override only if you are pointed at a Throttle staging or self-hosted
# environment. Defaults are correct for production usethrottle.dev.
# THROTTLE_API_BASE_URL=https://api.usethrottle.dev
# NEXT_PUBLIC_THROTTLE_CHECKOUT_URL=https://checkout.usethrottle.dev

# Parent origin sent to the PaymentEmbed iframe. Must be in your
# store's allowed_origins list (Embed config in the Throttle dashboard,
# or PUT /api/v1/embed-config). Falls back to NEXT_PUBLIC_BASE_URL or
# window.location.origin at runtime if omitted.
# NEXT_PUBLIC_THROTTLE_PARENT_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Clerk — https://clerk.com (default auth provider)
# ---------------------------------------------------------------------------
# Without these, the starter falls back to a localStorage-backed mock auth
# so the UI still renders. Wire Clerk before deploying to production.
# Both keys live in your Clerk dashboard (API Keys page).
CLERK_SECRET_KEY=replace_with_your_clerk_secret_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_your_clerk_publishable_key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
