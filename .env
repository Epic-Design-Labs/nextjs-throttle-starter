# Defaults shipped with the starter. Not secrets — safe to commit.
# Override anything here in .env.local if you mount Clerk at different paths.

# Where Clerk's <SignIn /> / <SignUp /> components are mounted.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register

# Where Clerk sends the buyer after a successful sign-in/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account
